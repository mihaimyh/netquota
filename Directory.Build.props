<Project>

  <PropertyGroup>
    <Authors>Mihai Dumitru</Authors>
    <Company>NetQuota</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/mihaimyh/netquota</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mihaimyh/netquota</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>quota;rate-limiting;dotnet;firestore;redis;postgresql;aspnetcore;billing;stripe;revenuecat</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
