<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit1051 pre-dates this change set (the repository keeps a large backlog); the suite must
         still build with -warnaserror. New tests pass TestContext.Current.CancellationToken. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" Version="10.1.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NetQuota\NetQuota.csproj" />
    <ProjectReference Include="..\..\src\NetQuota.AspNetCore\NetQuota.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\NetQuota.Billing\NetQuota.Billing.csproj" />
    <ProjectReference Include="..\..\src\NetQuota.Firestore\NetQuota.Firestore.csproj" />
    <ProjectReference Include="..\..\src\NetQuota.Grpc\NetQuota.Grpc.csproj" />
    <ProjectReference Include="..\..\src\NetQuota.Postgres\NetQuota.Postgres.csproj" />
    <ProjectReference Include="..\..\src\NetQuota.Redis\NetQuota.Redis.csproj" />
  </ItemGroup>

</Project>
